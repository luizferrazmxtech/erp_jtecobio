# Copie este arquivo para .env e ajuste os valores.

DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco do ERP novo. Sem POSTGRES_DB, usa SQLite (arquivo db.sqlite3).
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Banco do ERP antigo, restaurado a partir do .backup (somente leitura).
LEGADO_DB=legado
LEGADO_USER=erp
LEGADO_PASSWORD=erp
LEGADO_HOST=localhost
LEGADO_PORT=5432
# Código da JT Ecobio dentro do ERP antigo
LEGADO_EMPRESA=1
